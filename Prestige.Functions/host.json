{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "http": {
            "routePrefix": "api"
        },
        "cosmosDB": {
            "connectionMode": "Direct",
            "protocol": "Tcp",
            "leaseOptions": {
                "leasePrefix": "prestige"
            }
        }
    },
    "host": {
        "cors": {
            "allowedOrigins": [
                "http://localhost:5173",
                "http://localhost:3000",
                "https://localhost:5173",
                "https://portal.azure.com",
                "https://prestigefunctions.azurewebsites.net",
                "https://prestige.azurewebsites.net",
                "https://prestige-web.azurewebsites.net",
                "https://*.prestige.app",
                "https://prestige.app"
            ],
            "supportCredentials": false
        }
    },
    "functionTimeout": "00:30:00"
}